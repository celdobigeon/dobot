# Caches Python
__pycache__/
*.py[cod]
*$py.class

# Environnements virtuels
.venv/
venv/
env/

# Systeme
Thumbs.db
desktop.ini
.DS_Store

# Cache de maillages, regenere au premier lancement
.cache_maillages/

# Compilation du module RealSense (examples/perception/installer_realsense_macos.sh)
.build-realsense/

# Captures de la camera : volumineuses, propres a chaque scene
cellule/examples/perception/captures/

# Poids des modeles d'apprentissage (YOLO, SAM), telecharges par verifier_installation.py
cellule/examples/perception/modeles/

# Apprentissage de la perception : images collectees, annotations, exports
# et entrainements (examples/perception/apprentissage/)
cellule/examples/perception/apprentissage/dataset/
cellule/examples/perception/apprentissage/runs/
# images rendues par synthese_images.py (regenerables)
cellule/examples/perception/apprentissage/synthetique/
# etiquettes de coins, exports YOLO-pose (points_cles/etiquettes.py) et
# jeux RGB-H, cartes de hauteur (rgbd/exporter_rgbh.py) : regenerables
cellule/examples/perception/apprentissage/points_cles/donnees/
cellule/examples/perception/apprentissage/rgbd/donnees/
cellule/examples/perception/etalonnage_camera_robot*.json

# Etalonnage de la cellule : une MESURE de la machine du labo, pas du
# code. Clone ailleurs, il enverrait le bras ou la piece ne sera pas.
# L'exemple s'en passe : sans lui il calcule, et il le signale.
cellule/examples/convoyeur_etalonnage.json

# Modele CAO de la camera RealSense : 20 Mo a lui seul, soit la moitie
# de ce que pese Modele3D une fois nettoye. Il reste sur le poste. Pour
# l'afficher un jour : convertir_cao.py en fait un OBJ leger, et c'est
# l'OBJ qui aurait sa place ici.
cellule/Modele3D/Camera.step
cellule/examples/repere_fixe.json

# Journal du dernier essai du convoyeur : une trace de mise au point,
# refaite a chaque lancement.
cellule/examples/convoyeur_dernier_essai.log
