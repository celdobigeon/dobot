{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Simuler le fichier ouvert",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" },
      "justMyCode": true
    },
    {
      "name": "Simuler mon_programme.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mon_programme.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      "name": "Ouvrir le simulateur (IHM seule)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Diagnostic de l'installation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--verifier"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
